{
  "buildCommand": "node build.js",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(|sw.js|app.js|style.css|layout.css|fixes.css|index.html|config.js|manifest.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/store.js": {
      "maxDuration": 60
    },
    "api/scan.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/store",
      "schedule": "0 3 * * *"
    }
  ]
}